# Caddy gets and renews Let's Encrypt certificates automatically for both domains.
# The domains must point (DNS A record) to the server before starting.

{$APP_DOMAIN} {
	encode zstd gzip

	# PostHog (analytics + session replay) through our own domain so ad blockers
	# don't drop it. Neutral path on purpose: blockers match names like /posthog.
	handle_path /k7r/* {
		@assets path /static/* /array/*
		handle @assets {
			reverse_proxy https://us-assets.i.posthog.com {
				header_up Host us-assets.i.posthog.com
				header_up -Cookie
				header_up -Authorization
			}
		}
		handle {
			reverse_proxy https://us.i.posthog.com {
				header_up Host us.i.posthog.com
				header_up -Cookie
				header_up -Authorization
			}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$API_DOMAIN} {
	# No compression here: it would buffer the chat's streamed (SSE) responses
	reverse_proxy backend:8000
}
