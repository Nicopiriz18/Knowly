ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...

# --- PostHog AI Observability ---
# Traces every LLM call (tokens, cost, latency) per user. Leave the token empty to disable it.
# In production the same token also turns on web analytics and session replay in the frontend
# (baked in at build time; Caddy proxies it under /k7r). US region assumed; for EU change the hosts
# in deploy/Caddyfile and NEXT_PUBLIC_POSTHOG_UI_HOST.
# POSTHOG_PROJECT_TOKEN=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# --- Auth ---
# Random secret used to sign sessions and hash OTP codes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated admin emails (always have access and can approve requests)
ADMIN_EMAILS=tu@mail.com
# New emails get access instantly until MAX_USERS approved accounts exist (0 = no cap);
# after that they go to the waitlist for an admin to approve.
# AUTO_APPROVE_USERS=true
# MAX_USERS=200

# --- Ingest limits (admins are exempt from the per-user ones) ---
# MAX_CLASSES_PER_USER=10
# MAX_ACTIVE_INGESTS_PER_USER=1
# INGEST_LIMIT_PER_DAY=3
# MAX_VIDEO_MINUTES=240
# Videos processed at the same time; the rest wait in a queue. Keep at 1 on a small server.
# INGEST_WORKERS=1

# --- Email ---
# Local dev: catch every email in MailDev (npx maildev@2.2.1 -> web UI at http://localhost:1080).
# When SMTP_HOST is set, emails go there instead of Resend.
SMTP_HOST=localhost
SMTP_PORT=1025
# Production without a domain: Gmail with an app password (STARTTLS + login when SMTP_USERNAME is set)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=tu@gmail.com
#   SMTP_PASSWORD=<app password>  EMAIL_FROM=Knowly <tu@gmail.com>
SMTP_USERNAME=knowly.app.ai@gmail.com
SMTP_PASSWORD=
# Production: Resend. With neither SMTP_HOST nor RESEND_API_KEY, emails are printed to the backend console.
RESEND_API_KEY=re_...
# Must be a verified domain in Resend (onboarding@resend.dev only delivers to your own account email)
EMAIL_FROM=Knowly <no-reply@tudominio.com>

# --- URLs ---
# Public URL of the frontend (used in email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:3000
# Backend URL as seen from the browser. Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- YouTube ---
# Cookies file for yt-dlp. Needed on a server: YouTube asks datacenter IPs to sign in.
# Export it from a logged-in browser (see deploy/README.md) and leave empty locally.
# YTDLP_COOKIES_FILE=/app/data/youtube_cookies.txt

# If the backend runs behind a reverse proxy, set its IP (or *) so rate limits use the real client IP
# FORWARDED_ALLOW_IPS=*

# --- Production (docker-compose.prod.yml) ---
# Domains Caddy serves over HTTPS. Both must have a DNS A record pointing to the server.
# NEXT_PUBLIC_API_URL is derived from API_DOMAIN there, so it doesn't need to be set.
# APP_DOMAIN=knowly.duckdns.org
# API_DOMAIN=api.knowly.duckdns.org
